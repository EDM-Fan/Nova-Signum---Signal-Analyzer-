/* ==========================================================================
   SIGNAL ANALYZER — Dark Theme Stylesheet (gui/style.qss)
   Pass 4: Empty States, Alerts, Overlays & Reporting
   ========================================================================== */

/* --- Global Base --- */
QMainWindow {
    background-color: #0A0E14;
    color: #E4E9F0;
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 13px;
}

QWidget#centralWidget {
    background-color: #0A0E14;
    color: #E4E9F0;
    font-family: 'Inter', -apple-system, sans-serif;
}

QWidget {
    color: #E4E9F0;
    font-family: 'Inter', -apple-system, sans-serif;
}

/* --- Top Bar --- */
QFrame#topbar {
    background-color: #10151D;
    border-bottom: 1px solid #1E2733;
    min-height: 48px;
    max-height: 48px;
    padding: 0 16px;
}

QLabel#brandLabel {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.5px;
    color: #E4E9F0;
}

QLabel#brandDot {
    background-color: #4EE1B8;
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}

QLabel#fileField {
    color: #6B7684;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
}

QLabel#statusBadge {
    color: #4EE1B8;
    background-color: rgba(78, 225, 184, 0.08);
    border: 1px solid #1E4A40;
    padding: 4px 10px;
    font-size: 11px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
}

QLabel#statusBadge[statusState="busy"] {
    color: #F0A84E;
    background-color: rgba(240, 168, 78, 0.10);
    border-color: #4A3A1E;
}

QLabel#statusBadge[statusState="warn"] {
    color: #F0A84E;
    background-color: rgba(240, 168, 78, 0.12);
    border: 1px solid #78521A;
}

QLabel#statusBadge[statusState="error"] {
    color: #E85D5D;
    background-color: rgba(232, 93, 93, 0.10);
    border-color: #5C2323;
}

/* --- Alert Banner --- */
QFrame#alertBanner {
    border-radius: 0px;
    padding: 8px 14px;
    margin: 8px 16px 0px 16px;
}

QFrame#alertBanner[level="error"] {
    background-color: rgba(232, 93, 93, 0.12);
    border: 1px solid #E85D5D;
}

QFrame#alertBanner[level="warn"] {
    background-color: rgba(240, 168, 78, 0.12);
    border: 1px solid #F0A84E;
}

QFrame#alertBanner[level="success"] {
    background-color: rgba(78, 225, 184, 0.12);
    border: 1px solid #4EE1B8;
}

QLabel#bannerText {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
}

QFrame#alertBanner[level="error"] QLabel#bannerText {
    color: #FF8E8E;
}

QFrame#alertBanner[level="warn"] QLabel#bannerText {
    color: #F0A84E;
}

QFrame#alertBanner[level="success"] QLabel#bannerText {
    color: #4EE1B8;
}

QPushButton#btnBannerClose {
    background-color: transparent;
    border: none;
    color: #6B7684;
    font-weight: 700;
    font-size: 14px;
    padding: 2px 6px;
}

QPushButton#btnBannerClose:hover {
    color: #E4E9F0;
    background-color: rgba(255, 255, 255, 0.08);
}

/* --- Drag & Drop Overlay --- */
QFrame#dropOverlay {
    background-color: rgba(78, 225, 184, 0.08);
    border: 2px dashed #4EE1B8;
    margin: 12px;
}

QLabel#dropOverlayText {
    color: #4EE1B8;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

/* --- Empty State Viewport Placeholder --- */
QFrame#emptyStateWidget {
    background-color: #0A0E14;
    border: 1px solid #1E2733;
    margin: 16px;
}

QLabel#emptyStateGlyph {
    color: #1E4A40;
    font-size: 38px;
    font-weight: 300;
}

QLabel#emptyStateTitle {
    color: #E4E9F0;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
}

QLabel#emptyStateSubtitle {
    color: #6B7684;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
}

QLabel#emptyStateHint {
    color: #414C59;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
}

/* --- Panels & Columns --- */
QFrame#sidePanel {
    background-color: #10151D;
    border: 1px solid #1E2733;
}

QFrame#leftPanel {
    background-color: #10151D;
    border-right: 1px solid #1E2733;
}

QFrame#rightPanel {
    background-color: #10151D;
    border-left: 1px solid #1E2733;
}

QFrame#viewportArea {
    background-color: #0A0E14;
}

QFrame#card {
    background-color: #141B25;
    border: 1px solid #1E2733;
    padding: 10px;
}

QFrame#autodetectCard {
    background-color: rgba(78, 225, 184, 0.05);
    border: 1px solid #1E4A40;
    padding: 12px;
}

/* --- Headings --- */
QLabel#sectionHeading {
    color: #414C59;
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
}

/* --- Pipeline Stepper Widgets --- */
QFrame.stage-frame {
    background-color: transparent;
    border-left: 2px solid transparent;
    padding: 8px 12px 8px 16px;
}

QFrame.stage-frame[stageState="active"] {
    background-color: #141B25;
    border-left: 2px solid #4EE1B8;
}

QFrame.stage-frame[stageState="done"] {
    border-left: 2px solid #1E4A40;
}

QLabel.stage-label {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #E4E9F0;
}

QLabel.stage-label[stageState="pending"] {
    color: #6B7684;
}

QLabel.stage-sub {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #6B7684;
}

QLabel.stage-sub[stageState="pending"] {
    color: #414C59;
}

QLabel.stage-sub[stageState="active"] {
    color: #4EE1B8;
}

/* --- Viewport Footer Bar --- */
QFrame#viewportFooter {
    background-color: #10151D;
    border-top: 1px solid #1E2733;
    min-height: 38px;
    max-height: 38px;
    padding: 0 16px;
}

QLabel.readout-label {
    color: #6B7684;
    font-size: 11px;
    font-family: 'Inter', sans-serif;
}

QLabel.readout-value {
    color: #E4E9F0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    font-weight: 500;
}

/* --- Metrics --- */
QFrame.metric-row {
    border-bottom: 1px solid #1E2733;
    padding: 6px 0px;
}

QLabel.metric-k {
    color: #6B7684;
    font-size: 12px;
    font-family: 'Inter', sans-serif;
}

QLabel.metric-v {
    color: #E4E9F0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    font-weight: 500;
}

QLabel.metric-v[highlight="true"] {
    color: #4EE1B8;
    font-weight: 600;
}

QLabel.metric-v[warn="true"] {
    color: #F0A84E;
}

/* --- Buttons --- */
QPushButton {
    background-color: #141B25;
    border: 1px solid #29323F;
    border-radius: 0px;
    color: #E4E9F0;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    padding: 7px 12px;
    outline: none;
}

QPushButton:hover {
    background-color: #1C2430;
    border-color: #3E4B5E;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #0F151E;
    border-color: #1E2733;
    color: #E4E9F0;
}

QPushButton:focus {
    border-color: #4EE1B8;
}

QPushButton:disabled {
    background-color: #0D1219;
    border-color: #18202B;
    color: #3B4654;
}

/* Primary Teal Action Button */
QPushButton#btnPrimary, QPushButton#decodeButton, QPushButton[primary="true"] {
    background-color: rgba(78, 225, 184, 0.12);
    border: 1px solid #1E4A40;
    color: #4EE1B8;
    font-weight: 600;
}

QPushButton#btnPrimary:hover, QPushButton#decodeButton:hover, QPushButton[primary="true"]:hover {
    background-color: rgba(78, 225, 184, 0.24);
    border-color: #4EE1B8;
    color: #FFFFFF;
}

QPushButton#btnPrimary:pressed, QPushButton#decodeButton:pressed, QPushButton[primary="true"]:pressed {
    background-color: rgba(78, 225, 184, 0.08);
    border-color: #1E4A40;
    color: #4EE1B8;
}

QPushButton#btnPrimary:disabled, QPushButton#decodeButton:disabled, QPushButton[primary="true"]:disabled {
    background-color: #0D1219;
    border-color: #18202B;
    color: #244A3E;
}

/* Ghost Button */
QPushButton#btnGhost, QPushButton[ghost="true"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: #6B7684;
}

QPushButton#btnGhost:hover, QPushButton[ghost="true"]:hover {
    background-color: #141B25;
    border-color: #1E2733;
    color: #E4E9F0;
}

QPushButton#btnGhost:pressed, QPushButton[ghost="true"]:pressed {
    background-color: #0A0E14;
    color: #414C59;
}

/* --- Combo Boxes --- */
QComboBox {
    background-color: #141B25;
    border: 1px solid #1E2733;
    border-radius: 4px;
    padding: 6px 30px 6px 10px;
    color: #C8D0DA;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    min-height: 24px;
}

QComboBox:hover {
    border: 1px solid #29323F;
}

QComboBox:focus {
    border: 1px solid #4EE1B8;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #1E2733;
}

QComboBox::down-arrow {
    image: url(gui/icons/chevron_down.svg);
    width: 10px;
    height: 10px;
}

QComboBox::down-arrow:on {
    image: url(gui/icons/chevron_up.svg);
}

QComboBox QAbstractItemView {
    background-color: #10151D;
    border: 1px solid #1E2733;
    selection-background-color: #143028;
    selection-color: #4EE1B8;
    color: #E4E9F0;
    font-family: 'Inter', sans-serif;
    outline: none;
    padding: 4px;
}

/* --- Text Editors / Code / Data Output --- */
QTextEdit, QPlainTextEdit {
    background-color: #0A0E14;
    border: 1px solid #1E2733;
    border-radius: 0px;
    color: #E4E9F0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    padding: 6px 8px;
    selection-background-color: #1E4A40;
    selection-color: #4EE1B8;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #29323F;
}

/* --- Tab Widget --- */
QTabWidget::pane {
    background-color: #0A0E14;
    border: 1px solid #1E2733;
    border-top: none;
    top: 0px;
}

QTabBar::tab {
    background-color: #10151D;
    border: 1px solid #1E2733;
    border-bottom: 2px solid transparent;
    color: #6B7684;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    padding: 8px 18px;
    margin-right: 2px;
    margin-bottom: -1px;
}

QTabBar::tab:hover {
    color: #E4E9F0;
    background-color: #141B25;
    border-bottom: 2px solid #29323F;
}

QTabBar::tab:selected {
    color: #4EE1B8;
    background-color: #0A0E14;
    border-bottom: 2px solid #4EE1B8;
    font-weight: 600;
}

/* --- Progress Bar --- */
QProgressBar {
    background-color: #1E2733;
    border: 1px solid #1E2733;
    border-radius: 1px;
    min-height: 5px;
    max-height: 5px;
    text-align: right;
}

QProgressBar::chunk {
    background-color: #4EE1B8;
    border-radius: 0px;
}

QProgressBar#topBusyProgress {
    background-color: #141B25;
    border: 1px solid #1E2733;
    border-radius: 2px;
    min-height: 4px;
    max-height: 4px;
}

QProgressBar#topBusyProgress::chunk {
    background-color: #4EE1B8;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #10151D;
    border-top: 1px solid #1E2733;
    color: #6B7684;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    padding: 2px 10px;
}

/* --- Scroll Bars --- */
QScrollBar:vertical {
    background-color: #0A0E14;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #1E2733;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4EE1B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
}
