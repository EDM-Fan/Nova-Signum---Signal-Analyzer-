*.wav
*.npy

# Allow the curated starter samples explicitly
!samples/bpsk_1000ksps_f32.iq
!samples/qpsk_1000ksps_f32.iq
!samples/2fsk_1000ksps_f32.iq

# Large waterfall PNGs in samples/
samples/*_waterfall.png

